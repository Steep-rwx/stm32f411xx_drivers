CompileFlags:
  CompilationDatabase: build/Debug
Diagnostics:
  ClangTidy:
    Add:
      - bugprone-*
      - readability-braces-around-statements
      - readability-implicit-bool-conversion
      - readability-magic-numbers
    Remove:
      - bugprone-easily-swappable-parameters
  UnusedIncludes: Strict
InlayHints:
  Enabled: 'Yes'
  ParameterNames: 'Yes'
